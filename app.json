{
  "expo": {
    "name": "Beauty & Style",
    "slug": "beauty-style",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF69B4"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.beautystyle.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF69B4"
      },
      "package": "com.beautystyle.app",
      "versionCode": 1,
      "compileSdkVersion": 34,
      "targetSdkVersion": 34,
      "minSdkVersion": 24,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "backgroundColor": "#FF69B4",
      "name": "Beauty & Style"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Beauty & Style to access your camera for virtual try-on features."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Beauty & Style to access your photos for personalized style recommendations."
        }
      ]
    ],
    "extra": {
      "privacyPolicyUrl": "https://beautystyle.app/privacy",
      "termsOfServiceUrl": "https://beautystyle.app/terms"
    }
  }
}