# Environment variables — copy this file to .env and fill in real values
# NEVER commit the actual .env file to version control.

# ──────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://stayle:stayle_2026@localhost:5432/stayle_beauty"

# ──────────────────────────────────────────────────────────
# Redis (BullMQ job queue)
# ──────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ──────────────────────────────────────────────────────────
# S3-compatible object storage (AWS S3 or DigitalOcean Spaces)
# ──────────────────────────────────────────────────────────
S3_BUCKET=your-bucket-name
S3_KEY=your-access-key-id
S3_SECRET=your-secret-access-key
S3_REGION=us-east-1
# S3_ENDPOINT is optional — set for non-AWS providers (e.g. DigitalOcean Spaces)
# S3_ENDPOINT=https://nyc3.digitaloceanspaces.com

# ──────────────────────────────────────────────────────────
# AI providers (set at least REPLICATE_API_TOKEN for MVP)
# ──────────────────────────────────────────────────────────
REPLICATE_API_TOKEN=r8_your_replicate_token_here
STABILITY_API_KEY=sk-your_stability_key_here
OPENAI_API_KEY=sk-your_openai_key_here

# ──────────────────────────────────────────────────────────
# Authentication
# ──────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string

# ──────────────────────────────────────────────────────────
# Payments (Stripe)
# ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here

# ──────────────────────────────────────────────────────────
# Push notifications (Firebase / FCM)
# ──────────────────────────────────────────────────────────
FIREBASE_SERVER_KEY=your_firebase_server_key_here

# ──────────────────────────────────────────────────────────
# AI Style Service
# ──────────────────────────────────────────────────────────
AI_STYLE_PORT=3011

# ──────────────────────────────────────────────────────────
# Mobile app (Expo) — prefix with EXPO_PUBLIC_ to expose to client
# ──────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3011
