# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://beauty:beautypassword@localhost:5432/beautydb
POSTGRES_USER=beauty
POSTGRES_PASSWORD=beautypassword
POSTGRES_DB=beautydb

# ─── Redis (BullMQ job queue) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── MongoDB (Chat service) ───────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017/beauty-chat

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# ─── AI Providers ─────────────────────────────────────────────────────────────
# Primary: Replicate
REPLICATE_API_TOKEN=r8_your_replicate_api_token_here
REPLICATE_MODEL_VERSION=stability-ai/sdxl:latest

# Fallback: Stability AI
STABILITY_API_KEY=sk-your_stability_api_key_here

# Fallback: OpenAI (also used for Whisper transcription and translation)
OPENAI_API_KEY=sk-your_openai_api_key_here

# ─── AWS S3 (photo uploads) ───────────────────────────────────────────────────
S3_BUCKET=your-beauty-app-bucket-name
S3_KEY=your_aws_access_key_id
S3_SECRET=your_aws_secret_access_key
S3_REGION=us-east-1

# ─── Stripe (payments) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ─── Firebase (FCM push notifications) ───────────────────────────────────────
# Paste the full service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"...","client_email":"...","client_id":"..."}

# ─── Content Moderation ───────────────────────────────────────────────────────
# NSFW probability threshold (0.0 - 1.0). Images above this value are rejected.
NSFW_THRESHOLD=0.5

# ─── Service URLs (for inter-service communication) ──────────────────────────
NOTIFICATION_SERVICE_URL=http://notification-service:4003

# ─── Worker Config ────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=3

# ─── Agora (video/audio calls) — optional ────────────────────────────────────
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# ─── WhatsApp deep link base ─────────────────────────────────────────────────
WHATSAPP_API_URL=https://api.whatsapp.com/send
